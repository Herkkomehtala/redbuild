int Base64Decode(const unsigned char *src, size_t len, unsigned char *decoded_out, size_t *out_len) {
    size_t i, count, pad = 0;
    
    if (src == NULL || len == 0 || decoded_out == NULL) return -1;

    if (src[len - 1] == '=') pad++;
    if (len > 1 && src[len - 2] == '=') pad++;

    count = (len / 4 * 3) - pad;
    *out_len = count;
    
    size_t out_idx = 0;

    for (i = 0; i < len; i += 4) {
        
        unsigned char block[4];
        block[0] = b64_decode_table[src[i]];
        block[1] = b64_decode_table[src[i+1]];
        block[2] = b64_decode_table[src[i+2]];
        block[3] = b64_decode_table[src[i+3]];

        if (out_idx < count) {
            decoded_out[out_idx++] = (unsigned char) (block[0] << 2 | block[1] >> 4);
        }
        if (out_idx < count) {
            decoded_out[out_idx++] = (unsigned char) (block[1] << 4 | block[2] >> 2);
        }
        if (out_idx < count) {
            decoded_out[out_idx++] = (unsigned char) (block[2] << 6 | block[3]);
        }
    }
    return 0; // Success
}
