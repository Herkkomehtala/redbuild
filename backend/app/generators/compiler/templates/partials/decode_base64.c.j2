unsigned char *Base64Decode(const unsigned char *src, size_t len, size_t *out_len) {
    unsigned char *out, *pos, block[4];
    size_t i, count, pad = 0;
    
    if (src == NULL || len == 0) return NULL;

    if (src[len - 1] == '=') pad++;
    if (len > 1 && src[len - 2] == '=') pad++;

    count = (len / 4 * 3) - pad;
    *out_len = count;

    out = (unsigned char *) malloc(count);
    if (out == NULL) return NULL;
    pos = out;

    for (i = 0; i < len; i += 4) {
        block[0] = b64_decode_table[src[i]];
        block[1] = b64_decode_table[src[i+1]];
        block[2] = b64_decode_table[src[i+2]];
        block[3] = b64_decode_table[src[i+3]];

        *pos++ = (unsigned char) (block[0] << 2 | block[1] >> 4);
        if (pos < out + count) {
            *pos++ = (unsigned char) (block[1] << 4 | block[2] >> 2);
        }
        if (pos < out + count) {
            *pos++ = (unsigned char) (block[2] << 6 | block[3]);
        }
    }

    return out;
}
