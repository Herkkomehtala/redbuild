{
  "display_name": "Windows PE Compiler",
  "entry_module": "win_c_embedder",
  "options": [
    {
      "name": "data_source",
      "display_name": "Payload Data Source",
      "type": "select",
      "default": "embedded",
      "choices": [
        { "value": "embedded", "text": "Embed the Payload in Binary" },
        { "value": "file", "text": "Read Payload from File/UNC Path" },
        { "value": "http", "text": "Read Payload from HTTP(S) URL" }
      ]
    },
    {
      "name": "file_path",
      "display_name": "File/UNC Path to Payload",
      "type": "text",
      "placeholder": "e.g., C:\\payload.bin or \\\\server\\share\\payload.bin",
      "depends_on": {
        "option": "data_source",
        "value": "file"
      }
    },
    {
        "name": "url",
        "display_name": "URL to Payload",
        "type": "text",
        "placeholder": "e.g., https://example.com/payload.bin",
        "depends_on": {
            "option": "data_source",
            "value": "http"
        }
    },
    {
        "name": "user_agent",
        "display_name": "HTTP User-Agent",
        "type": "text",
        "default": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36",
        "depends_on": {
            "option": "data_source",
            "value": "http"
        }
    },
    {
      "name": "obfuscate_strings",
      "display_name": "Obfuscate URL & User-Agent Strings",
      "type": "checkbox",
      "default": "false",
      "depends_on": {
        "option": "data_source",
        "value": "http"
      }
    },
    {
        "name": "trust_invalid_cert",
        "display_name": "Trust Invalid HTTPS Certificates",
        "type": "checkbox",
        "default": "false",
        "depends_on": {
            "option": "data_source",
            "value": "http"
        }
    },
    {
      "name": "output_format",
      "display_name": "Output Format",
      "type": "select",
      "default": "exe",
      "choices": [
        { "value": "exe", "text": "EXE" },
        { "value": "dll", "text": "DLL" },
        { "value": "cpl", "text": "CPL" }
      ]
    },
    {
      "name": "debug_mode",
      "display_name": "Enable Debug Messages",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "api_resolver",
      "display_name": "API Resolution Method",
      "type": "select",
      "default": "hashed",
      "choices": [
        { "value": "string", "text": "No API hashing" },
        { "value": "hashed", "text": "API Hashing" },
        { "value": "recycled_gate", "text": "Recycled Gate (Indirect Syscalls)" }
      ]
    },
    {
      "name": "bytecode_encoding",
      "display_name": "Bytecode Encoding",
      "type": "select",
      "choices": [
        { "value": "", "text": "None" },
        { "value": "base64_encoder", "text": "Base64 Encode" },
        { "value": "base85_encoder", "text": "Base85 Encode" }
      ]
    },
    {
      "name": "bytecode_compression",
      "display_name": "Bytecode Compression",
      "type": "select",
      "choices": [
        { "value": "", "text": "None" },
        { "value": "mszip_compressor", "text": "MSZIP Compress" }
      ]
    },
    {
      "name": "export_name",
      "display_name": "DLL Export Name",
      "type": "text",
      "default": "DllRegisterServer",
      "placeholder": "e.g., RunPayload",
      "depends_on": {
        "option": "output_format",
        "value": "dll"
      }
    },
    {
      "name": "memory_strategy",
      "display_name": "Memory Strategy",
      "type": "select",
      "default": "virtualalloc",
      "choices": [
        { "value": "virtualalloc", "text": "VirtualAlloc (Standard Private)" },
        { "value": "mappedsection", "text": "Mapped Section (Standard Mapped)" },
        { "value": "driploader", "text": "DripLoader (Stealth Private + Slow Write)" },
        { "value": "modulestomping_fast", "text": "Module Stomping (Image Backed + Fast Write)" },
        { "value": "modulestomping_drip", "text": "Module Stomping (Image Backed + Drip Write)" }
      ]
    },
    {
      "name": "stomp_dll_path",
      "display_name": "Stomp Target DLL (Full Path)",
      "type": "text",
      "default": "C:\\Windows\\System32\\amsi.dll",
      "depends_on": {
          "option": "memory_strategy",
          "value": ["modulestomping_fast", "modulestomping_drip"]
      }
    },
    {
      "name": "drip_delay",
      "display_name": "Drip Delay (ms)",
      "type": "number",
      "default": 100,
      "depends_on": {
          "option": "memory_strategy",
          "value": ["driploader", "modulestomping_drip"]
      }
    },
    {
      "name": "execution_method",
      "display_name": "Execution Method",
      "type": "select",
      "default": "newthread",
      "choices": [
        { "value": "inprocess", "text": "In Process, No New Thread" },
        { "value": "newthread", "text": "In Process, New Thread" },
        { "value": "remoteapc", "text": "Early Cryo Bird Injection"}
      ]
    },
    {
      "name": "target_process",
       "display_name": "Target Process Name",
       "type": "text",
       "default": "RuntimeBroker.exe",
       "placeholder": "RuntimeBroker.exe",
       "depends_on": {
           "option": "execution_method",
           "value": "remoteapc"
        }
    },
    {
        "name": "obfuscate_execution_strings",
        "display_name": "Obfuscate Strings",
        "type": "checkbox",
        "default": "false",
        "depends_on": { "option": "execution_method", "value": "remoteapc" }
    },
    {
        "name": "evasion_features",
        "display_name": "Defense Evasion",
        "type": "multiselect",
        "choices": [
            { "value": "patch_etw", "text": "Patch ETW (Event Tracing)" },
            { "value": "unhook_ntdll", "text": "Unhook NTDLL" }
        ]
    },
    {
        "name": "guardrail_domain_joined",
        "display_name": "Domain Joined Check",
        "type": "checkbox",
        "default": "false"
    },
    {
        "name": "guardrail_hostname",
        "display_name": "Hostname (empty to disable)",
        "type": "text",
        "placeholder": "e.g. USER-PC"
    },
    {
        "name": "version_info_template_select",
        "display_name": "Load Version Info Template (Optional)",
        "type": "select",
        "choices": []
    },
    { "name": "version_info_company_name", "display_name": "Company Name", "type": "text", "placeholder": "Microsoft Corporation" },
    { "name": "version_info_file_description", "display_name": "File Description", "type": "text", "placeholder": "Host Process for Windows Services" },
    { "name": "version_info_file_version", "display_name": "File Version", "type": "text", "placeholder": "10,0,19041,1" },
    { "name": "version_info_internal_name", "display_name": "Internal Name", "type": "text", "placeholder": "svchost.exe" },
    { "name": "version_info_legal_copyright", "display_name": "Legal Copyright", "type": "text", "placeholder": "Microsoft Corporation. All rights reserved." },
    { "name": "version_info_original_filename", "display_name": "Original Filename", "type": "text", "placeholder": "svchost.exe" },
    { "name": "version_info_product_name", "display_name": "Product Name", "type": "text", "placeholder": "Microsoft Windows Operating System" },
    { "name": "version_info_product_version", "display_name": "Product Version", "type": "text", "placeholder": "10,0,19041,1" }
  ],
    "version_info_templates": {
    "exe": [
      {
        "name": "psr.exe",
        "company_name": "Microsoft Corporation",
        "file_description": "Steps Recorder",
        "file_version": "10.0.26100.3037 (WinBuild.160101.0800)",
        "internal_name": "psr.exe",
        "legal_copyright": "Microsoft Corporation. All rights reserved.",
        "original_filename": "psr.exe.mui",
        "product_name": "Microsoft Windows Operating System",
        "product_version": "10.0.26100.3037"
      },
      {
        "name": "dxgiadaptercache.exe",
        "company_name": "Microsoft Corporation",
        "file_description": "DXGI Adapter Cache",
        "file_version": "10.0.26100.6725 (WinBuild.160101.0800)",
        "internal_name": "DXGIAdapterCache.exe",
        "legal_copyright": "Microsoft Corporation. All rights reserved.",
        "original_filename": "DXGIAdapterCache.exe",
        "product_name": "Microsoft Windows Operating System",
        "product_version": "10.0.26100.6725"
      }
    ],
    "dll": [
      {
        "name": "msimg32.dll",
        "company_name": "Microsoft Corporation",
        "file_description": "GDIEXT Client DLL",
        "file_version": "10.0.26100.1882 (WinBuild.160101.0800)",
        "internal_name": "gdiext",
        "legal_copyright": "Microsoft Corporation. All rights reserved.",
        "original_filename": "gdiext",
        "product_name": "Microsoft Windows Operating System",
        "product_version": "10.0.26100.1882"
      }
    ],
    "cpl": [
      {
        "name": "sapi.cpl",
        "company_name": "Microsoft Corporation",
        "file_description": "Speech UX Control Panel",
        "file_version": "10.0.26100.1 (WinBuild.160101.0800)",
        "internal_name": "Sapi.cpl",
        "legal_copyright": "Microsoft Corporation. All rights reserved.",
        "original_filename": "Sapi.cpl.mui",
        "product_name": "Microsoft Windows Operating System",
        "product_version": "10.0.26100.1"
      }
    ]
  }
}