{
  "display_name": "Windows PE Compiler",
  "entry_module": "win_c_embedder",
  "options": [
    {
      "name": "data_source",
      "display_name": "Payload Data Source",
      "type": "select",
      "default": "embedded",
      "choices": [
        { "value": "embedded", "text": "Embed the Payload in Binary" },
        { "value": "file", "text": "Read Payload from File/UNC Path" },
        { "value": "http", "text": "Read Payload from HTTP(S) URL" }
      ]
    },
    {
      "name": "file_path",
      "display_name": "File/UNC Path to Payload",
      "type": "text",
      "placeholder": "e.g., C:\\payload.bin or \\\\server\\share\\payload.bin",
      "depends_on": {
        "option": "data_source",
        "value": "file"
      }
    },
    {
        "name": "url",
        "display_name": "URL to Payload",
        "type": "text",
        "placeholder": "e.g., https://example.com/payload.bin",
        "depends_on": {
            "option": "data_source",
            "value": "http"
        }
    },
    {
        "name": "user_agent",
        "display_name": "HTTP User-Agent",
        "type": "text",
        "default": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36",
        "depends_on": {
            "option": "data_source",
            "value": "http"
        }
    },
    {
      "name": "obfuscate_strings",
      "display_name": "Obfuscate URL & User-Agent Strings",
      "type": "checkbox",
      "default": "false",
      "depends_on": {
        "option": "data_source",
        "value": "http"
      }
    },
    {
        "name": "trust_invalid_cert",
        "display_name": "Trust Invalid HTTPS Certificates",
        "type": "checkbox",
        "default": "false",
        "depends_on": {
            "option": "data_source",
            "value": "http"
        }
    },
    {
      "name": "output_format",
      "display_name": "Output Format",
      "type": "select",
      "default": "exe",
      "choices": [
        { "value": "exe", "text": "EXE" },
        { "value": "dll", "text": "DLL" },
        { "value": "cpl", "text": "CPL" }
      ]
    },
    {
      "name": "debug_mode",
      "display_name": "Enable Debug Messages",
      "type": "checkbox",
      "default": "false"
    },
    {
      "name": "api_resolver",
      "display_name": "API Resolution Method",
      "type": "select",
      "default": "hashed",
      "choices": [
        { "value": "string", "text": "No API hashing" },
        { "value": "hashed", "text": "API Hashing" }
      ]
    },
    {
      "name": "bytecode_encoding",
      "display_name": "Bytecode Encoding (Pre-Processing)",
      "type": "select",
      "choices": [
        { "value": "", "text": "None" },
        { "value": "base64_encoder", "text": "Base64 Encode" },
        { "value": "base85_encoder", "text": "Base85 Encode" }
      ]
    },
    {
      "name": "bytecode_compression",
      "display_name": "Bytecode Compression (Pre-Processing)",
      "type": "select",
      "choices": [
        { "value": "", "text": "None" },
        { "value": "mszip_compressor", "text": "MSZIP Compress" }
      ]
    },
    {
      "name": "export_name",
      "display_name": "DLL Export Name",
      "type": "text",
      "default": "DllRegisterServer",
      "placeholder": "e.g., RunPayload",
      "depends_on": {
        "option": "output_format",
        "value": "dll"
      }
    },
    {
      "name": "allocation_method",
      "display_name": "Allocation Method",
      "type": "select",
      "default": "virtualalloc",
      "choices": [
        { "value": "virtualalloc", "text": "VirtualAlloc" },
        { "value": "mappedsection", "text": "Mapped Section" }
      ]
    },
    {
      "name": "execution_method",
      "display_name": "Execution Method",
      "type": "select",
      "default": "newthread",
      "choices": [
        { "value": "inprocess", "text": "In Process, No New Thread" },
        { "value": "newthread", "text": "In Process, New Thread" },
        { "value": "remoteapc", "text": "Early Cryo Bird Injection"}
      ]
    },
    {
      "name": "target_process",
       "display_name": "Target Process Name",
       "type": "text",
       "default": "RuntimeBroker.exe",
       "placeholder": "RuntimeBroker.exe",
       "depends_on": {
           "option": "execution_method",
           "value": "remoteapc"
        }
    },
    {
        "name": "obfuscate_execution_strings",
        "display_name": "Obfuscate Strings",
        "type": "checkbox",
        "default": "false",
        "depends_on": { "option": "execution_method", "value": "remoteapc" }
    }
  ]
}

