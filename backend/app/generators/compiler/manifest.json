{
  "display_name": "Windows PE Compiler",
  "entry_module": "win_c_embedder",
  "profiles": [
    {
      "name": "Simple",
      "description": "No obfuscations",
      "settings": {
        "api_resolver": "string",
        "memory_strategy": "virtualalloc",
        "execution_method": "newthread",
        "bytecode_encoding": "",
        "bytecode_compression": ""
      }
    },
    {
      "name": "Advanced",
      "description": "API hashing, payload compressed and encoded",
      "settings": {
        "api_resolver": "hashed",
        "memory_strategy": "mappedsection",
        "execution_method": "newthread",
        "bytecode_encoding": "base64_encoder",
        "bytecode_compression": "mszip_compressor"
      }
    },
    {
      "name": "Very Advanced",
      "description": "Indirect syscalls, remote process injection, module stomping",
      "settings": {
        "api_resolver": "recycled_gate",
        "memory_strategy": "modulestomping_fast",
        "execution_method": "remoteapc",
        "bytecode_encoding": "base85_encoder",
        "bytecode_compression": "mszip_compressor",
        "obfuscate_execution_strings": "true",
        "stomp_dll_path": "C:\\Windows\\System32\\DXCaptureReplay.dll",
        "target_process": "RuntimeBroker.exe"
      }
    }
  ],
